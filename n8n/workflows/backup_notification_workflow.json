      "type": "n8n-nodes-base.start",
      "typeVersion": 1,
      "position": [250, 300]
    },
    {
      "parameters": {
        "url": "http://backup-service:3001/backup/run",
        "method": "POST",
        "options": {}
      },
      "name": "Trigger Backup",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 2,
      "position": [450, 300]
    },
    {
      "parameters": {
        "url": "http://access-analytics-service:3010/analytics/file/latest",
