  "connections": {
    "Start": { "main": [[{ "node": "Trigger Backup", "type": "main", "index": 0 }]] },
    "Trigger Backup": { "main": [[{ "node": "Get Analytics", "type": "main", "index": 0 }]] },
    "Get Analytics": { "main": [[{ "node": "Send Notification", "type": "main", "index": 0 }]] }
