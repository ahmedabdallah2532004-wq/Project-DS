name: CI/CD Pipeline

on:
  push:
    branches: [ main ]
  pull_request:
    branches: [ main ]

jobs:
  lint:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v3
      - name: Use Node.js
        uses: actions/setup-node@v3
        with:
          node-version: '18'
      - run: npm install
      - run: npx eslint .

  build:
    needs: lint
    runs-on: ubuntu-latest
    strategy:
      matrix:
        service: [access-analytics-service, backup-service, notification-service, auth-service, audit-service]
    steps:
      - uses: actions/checkout@v3
      - name: Use Node.js
        uses: actions/setup-node@v3
        with:
          node-version: '18'
      - name: Install dependencies
        run: |
          cd ${{ matrix.service }}
          npm install
      - name: Build
        run: |
          cd ${{ matrix.service }}
          npm run build --if-present

  test:
    needs: build
    runs-on: ubuntu-latest
    strategy:
      matrix:
        service: [access-analytics-service, backup-service, notification-service, auth-service, audit-service]
    steps:
      - uses: actions/checkout@v3
      - name: Use Node.js
        uses: actions/setup-node@v3
        with:
          node-version: '18'
      - name: Install dependencies
        run: |
          cd ${{ matrix.service }}
          npm install
      - name: Run tests
        run: |
          cd ${{ matrix.service }}
          NODE_ENV=test npm test

  build-and-push:
    needs: test
    runs-on: ubuntu-latest
    if: github.event_name == 'push' && github.ref == 'refs/heads/main'
    strategy:
      matrix:
        service: [access-analytics-service, backup-service, notification-service, auth-service, audit-service]
    steps:
      - uses: actions/checkout@v3
      - name: Login to GHCR
        uses: docker/login-action@v2
        with:
          registry: ghcr.io
          username: ${{ github.actor }}
          password: ${{ secrets.GITHUB_TOKEN }}
      - name: Build and push
        uses: docker/build-push-action@v4
        with:
          context: ./${{ matrix.service }}
          push: true
          tags: ghcr.io/${{ github.repository }}/${{ matrix.service }}:latest

  deploy:
    needs: build-and-push
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v3
      - name: Install Helm
        uses: azure/setup-helm@v3
      - name: Deploy to K8s
        run: |
          # In a real scenario, you'd configure kubeconfig here
          echo "Simulating Helm deployment..."
          helm upgrade --install cse474 ./helm/cse474 --namespace cse474-prod --create-namespace
