global:
  scrape_interval: 15s

scrape_configs:
  - job_name: 'access-analytics-service'
    static_configs:
      - targets: ['access-analytics-service:3010']

  - job_name: 'backup-service'
    static_configs:
      - targets: ['backup-service:3001']

  - job_name: 'notification-service'
    static_configs:
      - targets: ['notification-service:3005']

  - job_name: 'auth-service'
    static_configs:
      - targets: ['auth-service:3006']

  - job_name: 'audit-service'
    static_configs:
      - targets: ['audit-service:3007']
