NODE_ENV=development
SERVICE_NAME=webhook-service
PORT=3005
OTEL_TRACING_ENABLED=false
OTEL_SERVICE_NAME=webhook-service
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces
METRICS_SERVICE_URL=http://metrics-service:3001
NOTIFICATION_SERVICE_URL=http://notification-service:3002
PREVIEW_SERVICE_URL=http://preview-service:3003
COMPRESSION_SERVICE_URL=http://compression-service:3004
WEBHOOK_SERVICE_URL=http://webhook-service:3005
SCHEDULER_SERVICE_URL=http://scheduler-service:3006
ACCESS_ANALYTICS_SERVICE_URL=http://access-analytics-service:3007
BACKUP_SERVICE_URL=http://backup-service:3008
API_KEY=
MONGO_URI=mongodb://127.0.0.1:27017/webhook-db
MONGO_RETRY_CONNECTION_DELAY_MS=5000
KAFKA_BROKERS=127.0.0.1:9092
KAFKA_TOPIC=events
KAFKA_STATUS_TOPIC=webhook-status
KAFKA_DEAD_LETTER_TOPIC=webhook-dead-letter
KAFKA_CLIENT_ID=webhook-service
KAFKA_GROUP_ID=webhook-service-group
KAFKA_RETRY_CONNECTION_DELAY_MS=5000
HTTP_TIMEOUT_MS=5000
WEBHOOK_RETRY_COUNT=3
WEBHOOK_RETRY_DELAY_MS=2000
ENABLE_SAMPLE_WEBHOOK_SEED=false
SAMPLE_WEBHOOK_URL=
SAMPLE_WEBHOOK_NAME=sample-webhook-receiver
