{
  "name": "@cse474/notification-service",
  "version": "1.0.0",
  "description": "Notification microservice for the distributed storage platform",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "pm2": "pm2-runtime start ecosystem.config.cjs",
    "migrate": "node src/db/migrate.js",
    "lint": "eslint .",
    "test": "vitest run --coverage",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@opentelemetry/auto-instrumentations-node": "^0.62.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.205.0",
    "@opentelemetry/sdk-node": "^0.205.0",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "kafkajs": "^2.2.4",
    "pm2": "^5.4.3",
    "prom-client": "^15.1.3",
    "pg": "^8.13.1",
    "pino": "^9.5.0",
    "pino-http": "^10.3.0",
    "swagger-ui-express": "^5.0.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^2.1.8",
    "eslint": "^9.25.1",
    "pg-mem": "^3.0.5",
    "supertest": "^7.1.0",
    "vitest": "^2.1.8"
  }
}
